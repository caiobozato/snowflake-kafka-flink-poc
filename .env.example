# Copy to .env and adjust. Compose reads .env automatically.

# Host port for the local Snowflake service (container always listens on 8085).
SNOWFLAKE_PORT=8085

# Log level for the Snowflake container: critical|error|warning|info|debug|trace
SNOWFLAKE_LOG_LEVEL=info

# Leave empty for in-memory databases (fresh on every restart).
# Set to /var/lib/snowflake to persist into the snowflake-data volume.
SNOWFLAKE_DB_PATH=

# --- Snowflake console (web SQL client) -----------------------------------
SNOWFLAKE_UI_PORT=8086
SNOWFLAKE_UI_DATABASE=PROD
SNOWFLAKE_UI_SCHEMA=DS_MODEL
SNOWFLAKE_UI_MAX_ROWS=1000
SNOWFLAKE_UI_LOG_LEVEL=info

# --- Redpanda -------------------------------------------------------------
# Host port for the Kafka API. Also becomes the advertised external address,
# so host clients keep working when you change it.
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_PROXY_PORT=18082
REDPANDA_ADMIN_PORT=19644

# error|warn|info|debug|trace
REDPANDA_LOG_LEVEL=info

# --- kafka-ui -------------------------------------------------------------
KAFKA_UI_PORT=8090

# --- NiFi (Openflow simulation) -------------------------------------------
# In production the source side is the Openflow Connector for Snowflake to Kafka:
# https://docs.snowflake.com/en/user-guide/data-integration/openflow/connectors/snowflake-to-kafka/setup
NIFI_PORT=8443
NIFI_USERNAME=admin
# NiFi requires at least 12 characters.
NIFI_PASSWORD=openflow-poc-local
NIFI_HEAP_INIT=512m
NIFI_HEAP_MAX=2g

# Source object the flow reads. A CDC view locally; a stream FQN in Openflow.
SNOWFLAKE_STREAM_FQN=PROD.DS_MODEL.MOD_ROD_SPM_SETPOINT_RECOMMENDATION_CDC
CHANGE_WATERMARK_COLUMN=UPDATED_ON

KAFKA_CDC_TOPIC=snowflake.ds_model.mod_rod_spm_setpoint_recommendation
KAFKA_MESSAGE_KEY_FIELD=WELL_ID
NIFI_POLL_INTERVAL=10 sec

# --- Flink ----------------------------------------------------------------
FLINK_UI_PORT=8081
FLINK_TASK_SLOTS=4

# Output topic for transformed records.
FLINK_SINK_TOPIC=ambyio.swo-poc-control-system.lufkin.speedRangeRecommendationUpdated
FLINK_CONSUMER_GROUP=flink-setpoint-recommendation
# earliest-offset replays the topic on every submit; latest-offset or
# group-offsets change that.
FLINK_SCAN_STARTUP_MODE=earliest-offset
